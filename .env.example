# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then fill in your Supabase project's URL and anon (publishable) key.
# These same two variables must also be added in Vercel under
# Project Settings -> Environment Variables, so the production build has them too.
# The anon key is safe to expose in client-side code — it's the public key meant
# for browser use, access is controlled by the database's Row Level Security policies.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
